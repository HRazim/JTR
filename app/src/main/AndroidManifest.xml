<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet pour l'API externe (Nominatim / géocodage) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Géolocalisation pour le Rappel de proximité sociale -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lecture des contacts natifs (importation à l'onboarding, v5.3) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Galerie in-app (lecture du MediaStore) : READ_MEDIA_IMAGES sur API 33+,
         READ_EXTERNAL_STORAGE en repli sur API < 33. VISUAL_USER_SELECTED permet
         l'accès partiel « Sélectionner des photos » d'Android 14+. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Broadcast pour réveiller l'app après redémarrage -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Rappels à la minute près (v7.0) : alarmes EXACTES. USE_EXACT_ALARM est adaptée à
         une app de rappels (auto-accordée API 33+, sans invite) ; SCHEDULE_EXACT_ALARM
         couvre Android 12 (API 31-32). En API ≤ 30, aucune permission n'est requise. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- v7.1.7 — INTÉGRITÉ DES DONNÉES : Auto Backup et transfert d'appareil DÉSACTIVÉS.
         JTR est 100 % local ; l'UNIQUE sauvegarde voulue est l'export `.jtr` manuel (mécanisme
         applicatif, indépendant). Avec allowBackup=true, l'OS incluait la base Room dans l'Auto
         Backup/Smart Switch et, à une réinstallation sans données, RESTAURAIT un instantané
         PÉRIMÉ → écrasement des contacts.
         • android:allowBackup="false" → désactive la sauvegarde CLOUD (toutes versions) et, sur
           API ≤ 30, le transfert d'appareil + adb.
         • android:dataExtractionRules → sur Android 12+ (API 31+), allowBackup ne régit PLUS le
           transfert d'appareil (Smart Switch) : @xml/data_extraction_rules EXCLUT toutes les
           données (base + prefs + photos) du cloud ET du device-transfer.
         Résultat : aucune restauration OS ne peut écraser la base ; une réinstallation repart
         sur une base vierge. -->
    <application
        android:name=".JTRApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JTR"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiver pour les événements de géofencing -->
        <receiver
            android:name=".worker.GeofenceBroadcastReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.RECEIVE_GEOFENCE_EVENT" />

        <!-- Rappels (v7.0) : déclenchement d'une alarme exacte (interne, non exporté). -->
        <receiver
            android:name=".worker.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Réarme les alarmes après reboot / mise à jour de l'app. -->
        <receiver
            android:name=".worker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider : expose les fichiers temporaires de partage (PNG/PDF)
             aux applications cibles via des URIs content:// révocables. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
