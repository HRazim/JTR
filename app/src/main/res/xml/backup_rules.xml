<?xml version="1.0" encoding="utf-8"?>
<!--
   v7.1.7 — INTÉGRITÉ DES DONNÉES (API ≤ 30, format pré-Android 12 `fullBackupContent`).
   Redondant avec android:allowBackup="false" (qui désactive déjà tout backup sur ces versions),
   mais maintenu COHÉRENT : exclut TOUTES les données — base Room (+ -wal/-shm), préférences,
   fichiers (photos) — de la sauvegarde complète. JTR est 100 % local ; seule la sauvegarde
   `.jtr` manuelle est voulue. Le transfert d'appareil sur Android 12+ est régi par
   @xml/data_extraction_rules. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
