<?xml version="1.0" encoding="utf-8"?>
<!--
   v7.1.7 — INTÉGRITÉ DES DONNÉES (Android 12+ / API 31+).
   JTR est 100 % local : l'UNIQUE sauvegarde voulue est l'export `.jtr` manuel.
   `android:allowBackup="false"` désactive déjà la sauvegarde CLOUD (toutes versions) et,
   sur API ≤ 30, le transfert d'appareil. MAIS sur Android 12+, `allowBackup` ne s'applique
   plus au TRANSFERT D'APPAREIL (Smart Switch / D2D) : seul ce fichier le régit.
   On EXCLUT donc TOUTES les données — base Room (+ -wal/-shm), préférences, fichiers
   (photos) — du backup cloud ET du transfert d'appareil → aucune restauration OS d'un
   instantané périmé ne peut écraser la base. Voir developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
